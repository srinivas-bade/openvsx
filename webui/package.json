{
    "name": "openvsx-webui",
    "version": "1.4.0",
    "description": "User interface for Eclipse Open VSX",
    "keywords": [
        "react",
        "frontend",
        "vscode",
        "extensions",
        "search"
    ],
    "license": "EPL-2.0",
    "homepage": "https://open-vsx.org",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eclipse-openvsx/openvsx.git",
        "directory": "webui"
    },
    "bugs": "https://github.com/eclipse-openvsx/openvsx/issues",
    "contributors": [
        {
            "name": "Jan Bicker",
            "email": "jan.bicker@typefox.io",
            "url": "https://www.typefox.io"
        },
        {
            "name": "Miro Spönemann",
            "email": "miro.spoenemann@typefox.io",
            "url": "https://www.typefox.io"
        },
        {
            "name": "Thomas Neidhart",
            "email": "thomas.neidhart@eclipse-foundation.org"
        },
        {
            "name": "Jordi Gómez Hidalgo",
            "email": "jordi.gomez@eclipse-foundation.org"
        }
    ],
    "files": [
        "lib",
        "src"
    ],
    "main": "lib/index",
    "types": "lib/index",
    "engines": {
        "node": ">=26.0.0"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@fontsource/roboto": "^5.3.0",
        "@mdit/plugin-alert": "^0.22.3",
        "@mui/icons-material": "^5.15.14",
        "@mui/material": "^5.15.14",
        "@mui/system": "^5.15.14",
        "@mui/x-charts": "^8.28.2",
        "@mui/x-data-grid": "^8.28.2",
        "@mui/x-date-pickers": "^8.27.2",
        "@tanstack/react-query": "^5.107.1",
        "@tanstack/react-query-devtools": "^5.107.1",
        "dompurify": "^3.4.17",
        "luxon": "^3.7.2",
        "markdown-it": "^14.1.0",
        "markdown-it-anchor": "^9.2.0",
        "react": "^18.2.0",
        "react-avatar-editor": "^15.0.0",
        "react-dom": "^18.2.0",
        "react-helmet-async": "^2.0.5",
        "react-router": "^7.18.2"
    },
    "resolutions": {
        "node-gyp": "^13.1.0",
        "@typescript-eslint/typescript-estree/minimatch": "^11.0.8"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.65.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.9",
        "@types/dompurify": "^3.0.5",
        "@types/express": "^5.0.6",
        "@types/luxon": "^3.7.6",
        "@types/markdown-it": "^14.2.0",
        "@types/node": "^26.6.6",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-parser-plain": "^0.1.1",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-testing-library": "^7.16.2",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.4",
        "jsdom": "^31.0.0",
        "prettier": "^3.10.0",
        "rimraf": "^6.1.4",
        "rollup-plugin-visualizer": "^7.1.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    },
    "scripts": {
        "clean": "rimraf lib && rimraf dist",
        "build": "tsc -p ./configs/lib.tsconfig.json && yarn run lint",
        "tsc": "tsc -p ./configs/app.tsconfig.json",
        "test": "vitest run",
        "smoke-tests": "playwright install && playwright test --config=./configs/playwright.config.ts",
        "lint": "eslint -c eslint.config.mjs src configs test '*'",
        "watch": "tsc -w -p ./tsconfig.json --preserveWatchOutput",
        "build:server": "tsc -p ./configs/server.tsconfig.json",
        "build:default": "yarn build:server && vite build",
        "watch:default": "yarn build:server && vite build --watch",
        "start:default": "node lib/default/server",
        "dev": "vite dev",
        "preview": "vite preview",
        "link2server": "sh -c 'ln -sf $(realpath dist) ../server/build/resources/main/static'",
        "prepack": "yarn clean && yarn build"
    },
    "packageManager": "yarn@4.18.1"
}
