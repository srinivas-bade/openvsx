{
    "name": "ovsx",
    "version": "1.4.0",
    "description": "Command line interface for Eclipse Open VSX",
    "keywords": [
        "cli",
        "vscode",
        "extensions",
        "publish"
    ],
    "license": "EPL-2.0",
    "homepage": "https://open-vsx.org",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eclipse-openvsx/openvsx.git",
        "directory": "cli"
    },
    "bugs": "https://github.com/eclipse-openvsx/openvsx/issues",
    "contributors": [
        {
            "name": "Miro Spönemann",
            "email": "miro.spoenemann@typefox.io",
            "url": "https://www.typefox.io"
        },
        {
            "name": "Thomas Neidhart",
            "email": "thomas.neidhart@eclipse-foundation.org"
        },
        {
            "name": "Jordi Gómez Hidalgo",
            "email": "jordi.gomez@eclipse-foundation.org"
        }
    ],
    "files": [
        "lib",
        "src"
    ],
    "main": "lib/index",
    "types": "lib/index",
    "bin": "bin/ovsx",
    "engines": {
        "node": ">=26.0.0"
    },
    "dependencies": {
        "@inquirer/prompts": "^8.8.0",
        "@vscode/vsce": "^4.1.0",
        "ci-info": "^4.5.0",
        "commander": "^15.1.0",
        "cross-keychain": "^2.0.0",
        "semver": "^7.8.6",
        "yauzl-promise": "^4.0.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.6.6",
        "@types/semver": "^7.8.0",
        "@types/yauzl-promise": "^4",
        "@types/yazl": "^3.3.1",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "eslint": "^10.14.0",
        "limiter": "^4.1.0",
        "rimraf": "^6.1.4",
        "typescript": "^6.0.3",
        "vite": "^8.3.8",
        "vitest": "^5.1.0",
        "yazl": "^3.3.1"
    },
    "scripts": {
        "clean": "rimraf lib",
        "build": "tsc -p ./tsconfig.json && yarn run lint",
        "watch": "tsc -w -p ./tsconfig.json",
        "test": "vitest run",
        "lint": "eslint -c ./configs/eslintrc.mjs src test",
        "prepare": "yarn run clean && yarn run build",
        "publish:next": "yarn npm publish --tag next",
        "publish:latest": "yarn npm publish --tag latest",
        "load-extensions": "node scripts/load-test-extensions.js"
    },
    "resolutions": {
        "@azure/msal-node": "^7.1.1",
        "@vscode/vsce/minimatch": "^11.0.8",
        "eslint/minimatch": "^11.0.8",
        "@eslint/config-array/minimatch": "^11.0.8",
        "@typescript-eslint/typescript-estree/minimatch": "^11.0.8"
    },
    "packageManager": "yarn@4.18.1"
}
